{
  "schemaVersion": "1",
  "id": "com.inboxgrinder.examples.tickets-reservations",
  "name": "Flights",
  "description": "Parses labelled travel confirmations and optionally checks flight schedules through approved Amadeus access.",
  "version": "0.1.0",
  "runtime": "wasm-component",
  "entrypoint": "tickets_reservations.wasm",
  "publisher": {
    "name": "Inbox Grinder",
    "repository": "https://github.com/inbox-grinder/plugin-tickets-reservations"
  },
  "compatibility": {
    "inboxGrinderApi": "0.1"
  },
  "permissions": [
    "read_metadata",
    "read_text_body",
    "read_html_body"
  ],
  "matches": {
    "subjectContains": [
      "flight",
      "itinerary",
      "booking",
      "travel confirmation"
    ]
  },
  "contentNeeds": {
    "metadata": true,
    "headers": [],
    "textBody": true,
    "htmlBody": true,
    "links": false,
    "attachments": "none"
  },
  "templates": [
    {
      "id": "flight",
      "kind": "declarative",
      "path": "template.json"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "recordContract": {
    "version": 1,
    "identityVersion": 1,
    "updateKeyVersion": 1,
    "capabilities": [
      {
        "name": "records",
        "version": 1,
        "required": true
      },
      {
        "name": "remote-service",
        "version": 1,
        "required": false
      },
      {
        "name": "scheduled-refresh",
        "version": 1,
        "required": false
      }
    ],
    "services": [
      {
        "id": "amadeus",
        "origin": "https://api.amadeus.com",
        "pathPrefixes": [
          "/v2/schedule/flights"
        ],
        "minimumIntervalSeconds": 1800,
        "authentication": "bearer"
      }
    ],
    "templates": [
      {
        "family": "flight",
        "version": 1
      }
    ]
  },
  "catalogue": {
    "categories": [
      "travel"
    ]
  }
}
